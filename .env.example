# Fresno Carrier Finder Configuration
# Note: For production on Windows, credentials can be saved directly in Windows Credential Manager via the UI.
# Alternatively, copy this file to .env for local environment configuration.

# Google Places API (New) Key
GOOGLE_PLACES_API_KEY=

# Twilio Credentials (v2 Lookup with Line Type Intelligence)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_SECRET=

# Local Server Settings
APP_HOST=127.0.0.1
APP_PORT=8765

# Defaults & Cost Controls
DEFAULT_LOCATION=Fresno, California, USA
MAX_BUSINESSES_DEFAULT=50
MAX_LOOKUPS_DEFAULT=25
MAX_SPEND_LIMIT_DOLLARS=5.00
TWILIO_LOOKUP_COST_PER_REQ=0.005
GOOGLE_PLACES_COST_PER_REQ=0.032
DEMO_MODE=false
